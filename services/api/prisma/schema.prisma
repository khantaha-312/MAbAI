// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Org {
  id        String   @id @default(cuid())
  name      String
  createdBy String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  portfolios Portfolio[]
}

model User {
  id        String   @id @default(cuid())
  orgId     String
  org       Org      @relation(fields: [orgId], references: [id])
  email     String   @unique
  clerkId   String   @unique
  createdBy String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  portfolios Portfolio[]
}

model Instrument {
  id        String   @id @default(cuid())
  symbol    String
  name      String
  assetType String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  symbolMappings SymbolMapping[]
  positions      Position[]
  riskFlags      RiskFlag[]

  @@unique([symbol, assetType])
}

model SymbolMapping {
  id            String     @id @default(cuid())
  instrumentId  String
  instrument    Instrument @relation(fields: [instrumentId], references: [id])
  provider      String
  providerSymbol String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([provider, providerSymbol])
}

model Portfolio {
  id        String    @id @default(cuid())
  orgId     String
  org       Org       @relation(fields: [orgId], references: [id])
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  name      String
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  positions Position[]
}

model Position {
  id           String    @id @default(cuid())
  portfolioId  String
  portfolio    Portfolio  @relation(fields: [portfolioId], references: [id])
  instrumentId String
  instrument   Instrument @relation(fields: [instrumentId], references: [id])
  quantity     Decimal
  avgCostBasis Decimal
  createdBy    String?
  updatedBy    String?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  riskFlags RiskFlag[]
}

model RiskFlag {
  id         String     @id @default(cuid())
  positionId String
  position   Position   @relation(fields: [positionId], references: [id])
  instrumentId String
  instrument Instrument @relation(fields: [instrumentId], references: [id])
  flagType   String
  severity   String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model PriceBar {
  id           String   @id @default(cuid())
  instrumentId String
  timestamp    DateTime
  open         Decimal
  high         Decimal
  low          Decimal
  close        Decimal
  volume       Decimal
  createdAt    DateTime @default(now())

  @@unique([instrumentId, timestamp])
}

model LedgerEntry {
  id                 String    @id @default(cuid())
  userId             String
  inputSnapshot      Json
  generatedOutput    Json
  modelProvider      String
  modelName          String
  promptTokens       Int?
  completionTokens   Int?
  totalCostUsd       Decimal?
  status             String    @default("pending")
  outcome            String?
  actualData         Json?
  resolvedAt         DateTime?
  createdAt          DateTime  @default(now())
}

model CalibrationScore {
  id            String   @id @default(cuid())
  userId        String
  score         Decimal
  sampleSize    Int
  computedAt    DateTime @default(now())
}

model PromptTemplate {
  id        String   @id @default(cuid())
  name      String   @unique
  content   String
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AlertRule {
  id        String    @id @default(cuid())
  userId    String
  config    Json
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  deliveries AlertDelivery[]
}

model AlertDelivery {
  id          String    @id @default(cuid())
  alertRuleId String
  alertRule   AlertRule @relation(fields: [alertRuleId], references: [id])
  channel     String
  status      String
  sentAt      DateTime?
  createdAt   DateTime  @default(now())
}

model Subscription {
  id                String    @id @default(cuid())
  orgId             String
  plan              String
  status            String
  currentPeriodEnd  DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model UsageCounter {
  id          String   @id @default(cuid())
  orgId       String
  metric      String
  count       Int      @default(0)
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([orgId, metric, periodStart])
}

model FeatureFlag {
  id        String   @id @default(cuid())
  key       String   @unique
  isEnabled Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
